{
  "name": "@webag/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos, schemas Zod e cliente da API gerados a partir de docs/arquitetura/api/openapi.yaml",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/index.native.d.ts",
      "default": "./dist/index.native.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "generate": "orval --config ./orval.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "orval": "8.48.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
