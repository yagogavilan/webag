{
  "$description": "Tokens de design do Webag. Fonte unica para apps/mobile (Expo) e apps/web (Next.js). Referencias entre tokens usam {caminho.do.token}. Saidas geradas por `pnpm --filter @webag/tokens build`. Racional e regras de uso em docs/design/identidade.md e docs/design/design-system.md.",
  "$version": "0.2.0",
  "$theme": "webag",
  "color": {
    "brand": {
      "$description": "Preenchido pelo tema ativo ($theme): theme/<nome>.json. Nao editar aqui."
    },
    "neutral": {
      "$description": "Preenchido pelo tema ativo ($theme): theme/<nome>.json. Nao editar aqui."
    },
    "feedback": {
      "success": {
        "base": "#1B6E3C",
        "subtle": "#E5F4EA",
        "border": "#9ED1AE"
      },
      "warning": {
        "base": "#7A4E00",
        "subtle": "#FFF3D6",
        "border": "#E9B949"
      },
      "danger": {
        "base": "#B3261E",
        "subtle": "#FCEAE8",
        "border": "#E8A29D"
      },
      "info": {
        "base": "#28569E",
        "subtle": "#E8F0FB",
        "border": "#9DB8E3"
      }
    },
    "rating": {
      "$description": "Estrela de avaliacao. Elemento grafico (3:1); a nota em numero sempre acompanha em texto.",
      "star": "#B76E00"
    },
    "surface": {
      "background": "{color.neutral.50}",
      "card": "{color.neutral.0}",
      "sunken": "{color.neutral.100}",
      "brandSubtle": "{color.brand.50}",
      "inverse": "{color.neutral.900}"
    },
    "text": {
      "primary": "{color.neutral.900}",
      "secondary": "{color.neutral.600}",
      "onBrand": "{color.neutral.0}",
      "brand": "{color.brand.700}",
      "link": "{color.brand.700}",
      "inverse": "{color.neutral.0}",
      "inverseAction": "{color.brand.200}",
      "disabled": "{color.neutral.400}",
      "success": "{color.feedback.success.base}",
      "warning": "{color.feedback.warning.base}",
      "danger": "{color.feedback.danger.base}",
      "info": "{color.feedback.info.base}"
    },
    "border": {
      "subtle": "{color.neutral.200}",
      "default": "{color.neutral.300}",
      "strong": "{color.neutral.500}",
      "focus": "{color.brand.600}",
      "danger": "{color.feedback.danger.base}"
    },
    "action": {
      "primary": "{color.brand.600}",
      "primaryHover": "{color.brand.700}",
      "primaryPressed": "{color.brand.800}",
      "primarySubtle": "{color.brand.50}",
      "primarySubtlePressed": "{color.brand.100}",
      "secondaryBorder": "{color.brand.600}",
      "destructive": "{color.feedback.danger.base}",
      "destructivePressed": "#8C1D18",
      "disabledFill": "{color.neutral.200}",
      "disabledText": "{color.neutral.500}"
    },
    "overlay": {
      "scrim": "rgba(28, 23, 33, 0.72)",
      "backdrop": "rgba(28, 23, 33, 0.48)"
    },
    "skeleton": {
      "base": "{color.neutral.200}",
      "highlight": "{color.neutral.100}"
    }
  },
  "font": {
    "family": {
      "$description": "web = Figtree (interface e numeros que mudam). display = Bricolage Grotesque 700/800 (titulos, preco estatico, numerais, momentos de marca; nunca abaixo de 20 px nem em corpo/botao/campo). Ambas OFL; woff2 em docs/design/recursos/fontes e docs/design/fonts.",
      "web": "\"Figtree\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "display": "\"Bricolage Grotesque\", \"Figtree\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif"
    },
    "size": {
      "xs": 12,
      "sm": 14,
      "md": 16,
      "lg": 20,
      "xl": 24,
      "2xl": 32,
      "3xl": 40,
      "4xl": 46,
      "5xl": 58,
      "6xl": 68,
      "7xl": 92
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "lineHeight": {
      "xs": 16,
      "sm": 20,
      "md": 24,
      "lg": 28,
      "xl": 32,
      "2xl": 40,
      "3xl": 48,
      "4xl": 48,
      "5xl": 60,
      "6xl": 68,
      "7xl": 88
    }
  },
