{
  "$description": "Tokens de design do Webag. Fonte unica para apps/mobile (Expo) e apps/web (Next.js). Referencias entre tokens usam {caminho.do.token}. Saidas geradas por `pnpm --filter @webag/tokens build`. Racional e regras de uso em docs/design/identidade.md e docs/design/design-system.md.",
  "$version": "0.2.0",
  "$theme": "webag",
  "color": {
    "brand": { "$description": "Preenchido pelo tema ativo ($theme): theme/<nome>.json. Nao editar aqui." },
    "neutral": { "$description": "Preenchido pelo tema ativo ($theme): theme/<nome>.json. Nao editar aqui." },
    "feedback": {
      "success": { "base": "#1B6E3C", "subtle": "#E5F4EA", "border": "#9ED1AE" },
      "warning": { "base": "#7A4E00", "subtle": "#FFF3D6", "border": "#E9B949" },
      "danger": { "base": "#B3261E", "subtle": "#FCEAE8", "border": "#E8A29D" },
      "info": { "base": "#28569E", "subtle": "#E8F0FB", "border": "#9DB8E3" }
    },
    "rating": {
      "$description": "Estrela de avaliacao. Elemento grafico (3:1); a nota em numero sempre acompanha em texto.",
      "star": "#B76E00"
    },
    "surface": {
      "background": "{color.neutral.50}",
      "card": "{color.neutral.0}",
      "sunken": "{color.neutral.100}",
      "brandSubtle": "{color.brand.50}",
      "inverse": "{color.neutral.900}"
    },
    "text": {
      "primary": "{color.neutral.900}",
      "secondary": "{color.neutral.600}",
      "onBrand": "{color.neutral.0}",
      "brand": "{color.brand.700}",
      "link": "{color.brand.700}",
      "inverse": "{color.neutral.0}",
      "inverseAction": "{color.brand.200}",
      "disabled": "{color.neutral.400}",
      "success": "{color.feedback.success.base}",
      "warning": "{color.feedback.warning.base}",
      "danger": "{color.feedback.danger.base}",
      "info": "{color.feedback.info.base}"
    },
    "border": {
      "subtle": "{color.neutral.200}",
      "default": "{color.neutral.300}",
      "strong": "{color.neutral.500}",
      "focus": "{color.brand.600}",
      "danger": "{color.feedback.danger.base}"
    },
    "action": {
      "primary": "{color.brand.600}",
      "primaryHover": "{color.brand.700}",
      "primaryPressed": "{color.brand.800}",
      "primarySubtle": "{color.brand.50}",
      "primarySubtlePressed": "{color.brand.100}",
      "secondaryBorder": "{color.brand.600}",
      "destructive": "{color.feedback.danger.base}",
      "destructivePressed": "#8C1D18",
      "disabledFill": "{color.neutral.200}",
      "disabledText": "{color.neutral.500}"
    },
    "overlay": {
      "scrim": "rgba(28, 23, 33, 0.72)",
      "backdrop": "rgba(28, 23, 33, 0.48)"
    },
    "skeleton": {
      "base": "{color.neutral.200}",
      "highlight": "{color.neutral.100}"
    }
  },
  "font": {
    "family": {
      "$description": "web = Figtree (texto corrido e interface). display = Fredoka (titulos, numeros grandes e momentos de marca). Ambas OFL; arquivos woff2 em docs/design/fonts.",
      "web": "\"Figtree\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "display": "\"Fredoka\", \"Figtree\", ui-rounded, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif"
    },
    "size": { "xs": 12, "sm": 14, "md": 16, "lg": 20, "xl": 24, "2xl": 32, "3xl": 40 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "lineHeight": { "xs": 16, "sm": 20, "md": 24, "lg": 28, "xl": 32, "2xl": 40, "3xl": 48 }
  },
  "textStyle": {
    "hero": { "family": "display", "size": "{font.size.3xl}", "lineHeight": "{font.lineHeight.3xl}", "weight": "{font.weight.bold}", "tabular": false },
    "display": { "family": "display", "size": "{font.size.2xl}", "lineHeight": "{font.lineHeight.2xl}", "weight": "{font.weight.bold}", "tabular": false },
    "title1": { "family": "display", "size": "{font.size.xl}", "lineHeight": "{font.lineHeight.xl}", "weight": "{font.weight.semibold}", "tabular": false },
    "title2": { "family": "display", "size": "{font.size.lg}", "lineHeight": "{font.lineHeight.lg}", "weight": "{font.weight.semibold}", "tabular": false },
    "body": { "family": "text", "size": "{font.size.md}", "lineHeight": "{font.lineHeight.md}", "weight": "{font.weight.regular}", "tabular": false },
    "bodyStrong": { "family": "text", "size": "{font.size.md}", "lineHeight": "{font.lineHeight.md}", "weight": "{font.weight.semibold}", "tabular": false },
    "label": { "family": "text", "size": "{font.size.md}", "lineHeight": "{font.lineHeight.md}", "weight": "{font.weight.semibold}", "tabular": false },
    "caption": { "family": "text", "size": "{font.size.sm}", "lineHeight": "{font.lineHeight.sm}", "weight": "{font.weight.regular}", "tabular": false },
    "captionStrong": { "family": "text", "size": "{font.size.sm}", "lineHeight": "{font.lineHeight.sm}", "weight": "{font.weight.semibold}", "tabular": false },
    "micro": { "family": "text", "size": "{font.size.xs}", "lineHeight": "{font.lineHeight.xs}", "weight": "{font.weight.semibold}", "tabular": false },
    "price": { "family": "text", "size": "{font.size.lg}", "lineHeight": "{font.lineHeight.lg}", "weight": "{font.weight.bold}", "tabular": true },
    "numeral": { "family": "text", "size": "{font.size.3xl}", "lineHeight": "{font.lineHeight.3xl}", "weight": "{font.weight.bold}", "tabular": true },
    "numeralBrand": { "family": "display", "size": "{font.size.3xl}", "lineHeight": "{font.lineHeight.3xl}", "weight": "{font.weight.bold}", "tabular": false }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "size": {
    "touchMin": 48,
    "controlSm": 40,
    "controlMd": 48,
    "controlLg": 56,
    "iconSm": 20,
    "iconMd": 24,
    "iconLg": 32,
    "iconEmpty": 64,
    "headerHeight": 56,
    "tabBarHeight": 64,
    "avatarMd": 56,
    "thumb": 96
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "full": 999,
    "tag": "{radius.md}",
    "control": 12,
    "card": "{radius.lg}",
    "sheet": "{radius.xl}",
    "hero": "{radius.2xl}",
    "pill": "{radius.full}"
  },
  "borderWidth": { "hairline": 1, "strong": 2 },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(28, 23, 33, 0.08)",
    "md": "0 4px 12px rgba(28, 23, 33, 0.10)",
    "lg": "0 8px 24px rgba(28, 23, 33, 0.14)"
  },
  "motion": {
    "duration": { "fast": 150, "base": 250, "slow": 400, "shimmer": 1200, "fly": 400, "celebrate": 1200 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)"
    }
  },
  "opacity": { "disabled": 0.38, "hover": 0.08, "pressed": 0.12 },
  "breakpoint": { "sm": 640, "md": 1024, "lg": 1280, "xl": 1536 },
  "layout": { "screenPaddingX": 16, "gutter": 16, "contentMaxWidth": 1200, "formMaxWidth": 480 },
  "zIndex": { "base": 0, "sticky": 10, "sheet": 20, "toast": 30, "modal": 40 },
  "native": {
    "$description": "Somente React Native. Nao vira CSS.",
    "fontFamily": {
      "regular": "Figtree_400Regular",
      "semibold": "Figtree_600SemiBold",
      "bold": "Figtree_700Bold",
      "displayMedium": "Fredoka_500Medium",
      "displaySemibold": "Fredoka_600SemiBold",
      "displayBold": "Fredoka_700Bold"
    },
    "maxFontSizeMultiplier": { "default": 1.5, "compact": 1.2, "heading": 1.3 },
    "shadowColor": "{color.neutral.900}",
    "shadow": {
      "sm": { "offsetY": 1, "blur": 2, "opacity": 0.08, "elevation": 1 },
      "md": { "offsetY": 4, "blur": 12, "opacity": 0.1, "elevation": 3 },
      "lg": { "offsetY": 8, "blur": 24, "opacity": 0.14, "elevation": 6 }
    },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "enter": [0, 0, 0, 1],
      "exit": [0.3, 0, 1, 1]
    },
    "haptics": {
      "selection": "selection",
      "light": "impactLight",
      "success": "notificationSuccess",
      "warning": "notificationWarning",
      "error": "notificationError"
    }
  }
}
