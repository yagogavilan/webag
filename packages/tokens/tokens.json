  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "size": {
    "touchMin": 48,
    "controlSm": 40,
    "controlMd": 48,
    "controlLg": 56,
    "iconSm": 20,
    "iconMd": 24,
    "iconLg": 32,
    "iconEmpty": 64,
    "headerHeight": 56,
    "tabBarHeight": 64,
    "avatarMd": 56,
    "thumb": 96
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 16,
    "xl": 24,
    "2xl": 32,
    "full": 999,
    "tag": "{radius.md}",
    "control": 14,
    "card": "{radius.xl}",
    "sheet": "{radius.2xl}",
    "hero": "{radius.2xl}",
    "pill": "{radius.full}",
    "button": "{radius.lg}",
    "sticker": 8,
    "seal": 7
  },
  "borderWidth": {
    "hairline": 1,
    "strong": 2
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(28, 23, 33, 0.08)",
    "md": "0 4px 12px rgba(28, 23, 33, 0.10)",
    "lg": "0 8px 24px rgba(28, 23, 33, 0.14)",
    "hard": "3px 3px 0 {color.neutral.900}",
    "hardLg": "4px 4px 0 {color.neutral.900}"
  },
  "motion": {
    "duration": {
      "fast": 150,
      "base": 250,
      "slow": 400,
      "shimmer": 1200,
      "fly": 400,
      "celebrate": 1200,
      "barsIn": 500,
      "cascade": 550,
      "cascadeStep": 55,
      "count": 450,
      "confetti": 1500,
      "stage": 450,
      "bob": 2400,
      "shake": 350,
      "loader": 900
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "cascadeMax": 8
  },
  "opacity": {
    "disabled": 0.38,
    "hover": 0.08,
    "pressed": 0.12
  },
  "breakpoint": {
    "sm": 640,
    "md": 1024,
    "lg": 1280,
    "xl": 1536
  },
  "layout": {
    "screenPaddingX": 16,
    "gutter": 16,
    "contentMaxWidth": 1200,
    "formMaxWidth": 480
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "sheet": 20,
    "toast": 30,
    "modal": 40
  },
  "native": {
    "$description": "Somente React Native. Nao vira CSS.",
    "fontFamily": {
      "regular": "Figtree_400Regular",
      "semibold": "Figtree_600SemiBold",
      "bold": "Figtree_700Bold",
      "displayMedium": "BricolageGrotesque_600SemiBold",
      "displaySemibold": "BricolageGrotesque_600SemiBold",
      "displayBold": "BricolageGrotesque_700Bold",
      "extrabold": "Figtree_800ExtraBold",
      "displayExtraBold": "BricolageGrotesque_800ExtraBold"
    },
    "maxFontSizeMultiplier": {
      "default": 1.5,
      "compact": 1.2,
      "heading": 1.3
    },
    "shadowColor": "{color.neutral.900}",
    "shadow": {
      "sm": {
        "offsetY": 1,
        "blur": 2,
        "opacity": 0.08,
        "elevation": 1
      },
      "md": {
        "offsetY": 4,
        "blur": 12,
        "opacity": 0.1,
        "elevation": 3
      },
      "lg": {
        "offsetY": 8,
        "blur": 24,
        "opacity": 0.14,
        "elevation": 6
      }
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "enter": [
        0,
        0,
        0,
        1
      ],
      "exit": [
        0.3,
        0,
        1,
        1
      ],
      "brand": [
        0.2,
        0.8,
        0.2,
        1
      ]
    },
    "haptics": {
      "selection": "selection",
      "light": "impactLight",
      "success": "notificationSuccess",
      "warning": "notificationWarning",
      "error": "notificationError"
    },
    "spring": {
      "press": {
        "damping": 15,
        "stiffness": 400
      },
      "pop": {
        "damping": 9,
        "stiffness": 180
      }
    },
    "shadowHard": {
      "offset": 3,
      "offsetLg": 4
    }
  },
  "shape": {
    "$description": "Inclinacao Webag (simbolo v4a): selos, segmentos de progresso, marca-texto e cortes diagonais de bloco. Texto e foto nunca sao inclinados. Graus.",
    "lean": -8,
    "cutHeight": 64
  }
}
