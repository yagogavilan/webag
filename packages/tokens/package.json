{
  "name": "@webag/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Design tokens do Webag: JSON (fonte), TypeScript para React Native e CSS variables para web.",
  "type": "module",
  "sideEffects": [
    "./css/tokens.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native.ts",
    "./css": "./css/tokens.css",
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "src",
    "css",
    "theme",
    "tokens.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-contrast.mjs",
    "palette": "node scripts/palette-report.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
