{
  "name": "@webag/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App do cliente Webag (Expo + Expo Router). Lojista e admin são web (DEC-005)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env ./node_modules/expo/bin/cli start",
    "android": "node --env-file-if-exists=../../.env ./node_modules/expo/bin/cli start --android",
    "ios": "node --env-file-if-exists=../../.env ./node_modules/expo/bin/cli start --ios",
    "web": "node --env-file-if-exists=../../.env ./node_modules/expo/bin/cli start --web",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --ci",
    "doctor": "expo-doctor",
    "e2e": "maestro test e2e",
    "web:compra": "node scripts/web-compra.cjs",
    "assets": "node scripts/build-assets.mjs",
    "assets:art": "node scripts/build-art.mjs",
    "assets:icons": "node scripts/build-icons.mjs",
    "assets:licenses": "node scripts/build-license-texts.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo-google-fonts/figtree": "0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@hookform/resolvers": "^7.0.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "5.108.0",
    "@webag/shared": "workspace:*",
    "@webag/tokens": "workspace:*",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1",
    "socket.io-client": "^4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "30.5.2",
    "jest-expo": "~58.0.15",
    "sharp": "0.35.5",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  }
}
