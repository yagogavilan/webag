{
  "name": "@webag/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "App do cliente Webag (Expo + Expo Router). Lojista e admin são web (DEC-005)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --ci",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "0.4.1",
    "@webag/shared": "workspace:*",
    "@webag/tokens": "workspace:*",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "30.5.2",
    "jest-expo": "~58.0.15",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
