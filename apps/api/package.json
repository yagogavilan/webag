{
  "name": "@webag/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Webag (NestJS, monólito modular — ADR-007)",
  "type": "module",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && vitest run --config ./vitest.config.e2e.ts",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/platform/database/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env seed/index.ts",
    "db:migrate:prod": "node dist/platform/database/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/s3-presigned-post": "3.1171.0",
    "@aws-sdk/s3-request-presigner": "3.1171.0",
    "@nestjs/common": "12.5.1",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/platform-socket.io": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/terminus": "12.2.0",
    "@nestjs/websockets": "12.5.1",
    "@sentry/node": "11.14.0",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.11.1",
    "mercadopago": "3.6.2",
    "nestjs-pino": "5.3.2",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.13",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.5.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@webag/shared": "workspace:*",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
