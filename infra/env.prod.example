# Webag — variáveis de PRODUÇÃO (servidor). Modelo; o arquivo real é o `.env` na raiz do repositório no servidor.
# Como usar (passo a passo completo em docs/deploy/guia-deploy.md):
#   sh infra/scripts/gen-secrets.sh        # cria o .env a partir deste modelo e já sorteia todos os segredos
#   nano .env                              # preencha os campos marcados [PREENCHER]
# NUNCA commite o .env (está no .gitignore) e nunca cole o conteúdo dele em chat, e-mail ou issue.
# Linhas com GERAR_* são trocadas por valores aleatórios pelo gen-secrets.sh. Guarde uma cópia do .env num gerenciador de senhas
# (1Password, Bitwarden): sem ele, um servidor novo não decifra o que está no banco (MFA_ENC_KEY, PAYMENT_TOKEN_ENC_KEY).
# Tabela de onde pegar cada chave: docs/deploy/guia-deploy.md, seção "Variáveis".

# ============================ Domínio e HTTPS ============================
# Quatro nomes (subdomínios) apontando para o IP do servidor (registro DNS tipo A). Sem "https://" e sem "/" no fim.
# O admin e o lojista PRECISAM ser hosts diferentes (SEC-116): o painel recusa tudo se faltar um deles.
API_HOST=api.exemplo.com.br
ADMIN_HOST=admin.exemplo.com.br
LOJISTA_HOST=lojista.exemplo.com.br
FILES_HOST=arquivos.exemplo.com.br
# E-mail que o Let's Encrypt usa para avisar se o certificado estiver para vencer.
LETSENCRYPT_EMAIL=[PREENCHER]@exemplo.com.br
# storage-local = guarda as fotos no próprio servidor (RustFS). Se for usar Cloudflare R2 / AWS S3, apague esta linha
# e preencha S3_* abaixo (veja o guia).
COMPOSE_PROFILES=storage-local

# ============================ Versão das imagens ============================
WEBAG_VERSION=latest
# Apple Silicon/ARM (servidor ARM): POSTGIS_IMAGE=imresamu/postgis:18-3.6-alpine
POSTGIS_IMAGE=postgis/postgis:18-3.6-alpine
# Pública (vai para o navegador do painel): WhatsApp de suporte, só dígitos com DDI. Opcional. Muda só com rebuild do web.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ============================ PostgreSQL ============================
POSTGRES_USER=webag
# Só letras e números (entra numa URL). Gerado pelo gen-secrets.sh.
POSTGRES_PASSWORD=GERAR_HEX
POSTGRES_DB=webag

# ============================ Redis ============================
REDIS_PASSWORD=GERAR_HEX

# ============================ API: segredos (todos DIFERENTES entre si; o boot recusa repetição) ============================
LOG_LEVEL=info
JWT_ACCESS_SECRET=GERAR_SEGREDO
AUTH_HMAC_KEY=GERAR_SEGREDO
CODE_HMAC_KEY=GERAR_SEGREDO
RECOVERY_HMAC_KEY=GERAR_SEGREDO
# Cifra o segredo TOTP dos admins. Perdeu = todos os admins precisam reconfigurar o 2º fator. Guarde FORA do servidor.
MFA_ENC_KEY=GERAR_SEGREDO
# Segredo entre o painel web (BFF) e a API (SEC-129; >= 32 caracteres). Mesmo valor nos dois lados. Rotação: guia, "Rotação de segredos".
BFF_SHARED_SECRET=GERAR_SEGREDO
# Cifra os tokens OAuth do Mercado Pago dos lojistas (AES-256: 32 bytes em base64). Perdeu = lojistas precisam reconectar o MP.
PAYMENT_TOKEN_ENC_KEY=GERAR_CHAVE_AES

# ============================ Pagamentos (Mercado Pago) ============================
# Em produção o provedor "fake" é recusado: sem as 2 chaves abaixo a API não sobe (ver "Pendência" no guia, seção 1).
PAYMENT_PROVIDER=mercadopago
# [PREENCHER] Access Token de PRODUÇÃO (começa com APP_USR-). Credencial "TEST-" é recusada em produção.
MP_ACCESS_TOKEN=
# [PREENCHER] Assinatura secreta do webhook (painel do MP > Suas integrações > Webhooks > "Revelar" a assinatura).
MP_WEBHOOK_SECRET=
# [PREENCHER] Aplicação do MP (painel > Suas integrações > a aplicação da Webag > Credenciais de produção): Client ID e Client Secret do OAuth do split.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# [PREENCHER] Mesma URL cadastrada em "URLs de redirecionamento" do app do MP (HTTPS).
MP_OAUTH_REDIRECT_URI=
MP_PAYER_DOCUMENT_REQUIRED=false

# ============================ E-mail transacional (SMTP) ============================
# O app usa STARTTLS: use a porta 587 (a 465, TLS implícito, não funciona com a versão atual).
# [PREENCHER] Dados do provedor (Brevo, Resend, Amazon SES, Mailgun...). Ver guia.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente: precisa ser de um domínio verificado no provedor (SPF/DKIM).
SMTP_FROM="Webag <nao-responda@exemplo.com.br>"

# ============================ Armazenamento de arquivos (S3) ============================
# Padrão do compose de produção: RustFS no próprio servidor (perfil storage-local), exposto em https://FILES_HOST.
# Com R2/S3: ajuste as 7 linhas (endpoint, região, chaves, buckets, URL pública) e apague COMPOSE_PROFILES acima.
S3_ENDPOINT=https://arquivos.exemplo.com.br
S3_REGION=us-east-1
S3_ACCESS_KEY=GERAR_HEX
S3_SECRET_KEY=GERAR_SEGREDO
S3_BUCKET_PUBLIC=webag-public
S3_BUCKET_PRIVATE=webag-private
# Base das URLs das fotos públicas: https://FILES_HOST/<bucket público> (R2: o domínio público/custom do bucket).
S3_PUBLIC_URL=https://arquivos.exemplo.com.br/webag-public
S3_FORCE_PATH_STYLE=true

# ============================ Geolocalização ============================
# http = ViaCEP + Nominatim (único valor aceito em produção). Nominatim exige uso moderado (política do OpenStreetMap).
GEOCODING_PROVIDER=http

# ============================ Observabilidade ============================
# [opcional] DSN do Sentry. ATENÇÃO: a API e o app ainda NÃO leem esta variável (verificado 2026-11-18); fica reservada.
SENTRY_DSN=

# ============================ Primeiro administrador (seed de produção) ============================
# Usado UMA vez por `sh infra/scripts/prod.sh run --rm seed`. Depois APAGUE estas duas linhas do .env.
# O admin precisa configurar o 2º fator (TOTP) no primeiro login e trocar a senha.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ============================ Backup (ver docs/deploy/guia-deploy.md, "Backup") ============================
# Frase que cifra os backups do banco (os dumps têm dados pessoais: LGPD). Guarde FORA do servidor: sem ela o backup não abre.
BACKUP_PASSPHRASE=GERAR_SEGREDO
# Horário (UTC) do backup diário: minuto hora * * *  (03:15 UTC = 00:15 em Brasília).
BACKUP_CRON="15 3 * * *"
# Quantos dias de backup ficam no servidor e na nuvem.
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE_KEEP_DAYS=30
# Cópia FORA do servidor (obrigatória na prática: backup só no mesmo disco morre junto). Bucket S3/R2 SEPARADO do de arquivos,
# com chave própria que só escreve nele. Vazio = só local (o log avisa).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# [opcional] URL de monitoramento (healthchecks.io): o backup chama no fim com sucesso; se parar de chamar, você recebe alerta.
BACKUP_HEARTBEAT_URL=
