# Webag — variáveis de PRODUÇÃO (servidor). Modelo; o arquivo real é o `.env` na raiz do repositório no servidor.
# Como usar (passo a passo completo em docs/deploy/guia-deploy.md):
#   sh infra/scripts/gen-secrets.sh        # cria o .env a partir deste modelo e já sorteia todos os segredos
#   nano .env                              # preencha os campos marcados [PREENCHER]
# NUNCA commite o .env (está no .gitignore) e nunca cole o conteúdo dele em chat, e-mail ou issue.
# Linhas com GERAR_* são trocadas por valores aleatórios pelo gen-secrets.sh. Guarde uma cópia do .env num gerenciador de senhas
# (1Password, Bitwarden): sem ele, um servidor novo não decifra o que está no banco (MFA_ENC_KEY, PAYMENT_TOKEN_ENC_KEY).
# Tabela de onde pegar cada chave: docs/deploy/guia-deploy.md, seção "Variáveis".

# ============================ Domínio e HTTPS ============================
# Cinco nomes apontando para o IP do servidor (registro DNS tipo A). Sem "https://" e sem "/" no fim.
# PUBLIC_HOST é o site público (página inicial, privacidade, termos, exclusão de conta, página segura do cartão): o domínio
# principal, ex.: webag.com.br. Esses endereços entram nos formulários das lojas (Apple e Google) e no app (EXPO_PUBLIC_WEB_URL).
# O admin e o lojista PRECISAM ser hosts diferentes (SEC-116): o painel recusa tudo se faltar um deles.
API_HOST=api.exemplo.com.br
ADMIN_HOST=admin.exemplo.com.br
LOJISTA_HOST=lojista.exemplo.com.br
# O compose monta ADMIN_WEB_URL=https://<ADMIN_HOST> e LOJISTA_WEB_URL=https://<LOJISTA_HOST> na API (links de e-mail de cada painel; A-01).
FILES_HOST=arquivos.exemplo.com.br
PUBLIC_HOST=exemplo.com.br
# Links das lojas de aplicativos, para os botões de download do site. Deixe vazio até o app ser publicado (a página mostra "em breve").
# Só https. Preencha depois do G5, com os links reais (Google Play e App Store).
PLAY_STORE_URL=
APP_STORE_URL=
# E-mail que o Let's Encrypt usa para avisar se o certificado estiver para vencer.
LETSENCRYPT_EMAIL=[PREENCHER]@exemplo.com.br
# storage-local = guarda as fotos no próprio servidor (RustFS). Se for usar Cloudflare R2 / AWS S3, apague esta linha
# e preencha S3_* abaixo (veja o guia).
COMPOSE_PROFILES=storage-local

# ============================ Versão das imagens ============================
WEBAG_VERSION=latest
# Apple Silicon/ARM (servidor ARM): POSTGIS_IMAGE=imresamu/postgis:18-3.6-alpine
POSTGIS_IMAGE=postgis/postgis:18-3.6-alpine
# Pública (vai para o navegador do painel): WhatsApp de suporte, só dígitos com DDI. Opcional. Muda só com rebuild do web.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ============================ PostgreSQL ============================
POSTGRES_USER=webag
# Só letras e números (entra numa URL). Gerado pelo gen-secrets.sh.
POSTGRES_PASSWORD=GERAR_HEX
POSTGRES_DB=webag
# Ajuste ao tamanho do servidor (tabela em docs/deploy/guia-deploy.md, "Desempenho do banco"). Padrões abaixo: VPS de 4 GB de RAM.
#   8 GB:  PG_SHARED_BUFFERS=2GB   PG_EFFECTIVE_CACHE_SIZE=5GB   PG_WORK_MEM=16MB  PG_MAINTENANCE_WORK_MEM=256MB
#   16 GB: PG_SHARED_BUFFERS=4GB   PG_EFFECTIVE_CACHE_SIZE=11GB  PG_WORK_MEM=24MB  PG_MAINTENANCE_WORK_MEM=512MB
PG_SHARED_BUFFERS=768MB
PG_EFFECTIVE_CACHE_SIZE=2GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=100

# ============================ Redis ============================
REDIS_PASSWORD=GERAR_HEX

# ============================ API: segredos (todos DIFERENTES entre si; o boot recusa repetição) ============================
LOG_LEVEL=info
JWT_ACCESS_SECRET=GERAR_SEGREDO
AUTH_HMAC_KEY=GERAR_SEGREDO
CODE_HMAC_KEY=GERAR_SEGREDO
RECOVERY_HMAC_KEY=GERAR_SEGREDO
# Cifra o segredo TOTP dos admins. Perdeu = todos os admins precisam reconfigurar o 2º fator. Guarde FORA do servidor.
MFA_ENC_KEY=GERAR_SEGREDO
# Segredo entre o painel web (BFF) e a API (SEC-129; >= 32 caracteres). Mesmo valor nos dois lados. Rotação: guia, "Rotação de segredos".
BFF_SHARED_SECRET=GERAR_SEGREDO
# Cifra os tokens OAuth do Mercado Pago dos lojistas (AES-256: 32 bytes em base64). Perdeu = lojistas precisam reconectar o MP.
PAYMENT_TOKEN_ENC_KEY=GERAR_CHAVE_AES

# ============================ Ambiente ============================
# production (padrão) ou staging. Só o staging aceita PAYMENT_PROVIDER=fake, credencial TEST- do Mercado Pago e
# GEOCODING_PROVIDER=fake (ensaio ponta a ponta sem dinheiro real). Segredos de desenvolvimento são recusados nos dois.
# Nunca use staging com clientes reais.
APP_ENV=production

# ============================ Pagamentos (Mercado Pago) ============================
# Em produção o provedor "fake" é recusado: sem as 2 chaves abaixo a API não sobe (ver "Pendência" no guia, seção 1).
PAYMENT_PROVIDER=mercadopago
# [PREENCHER] Access Token de PRODUÇÃO (começa com APP_USR-). Credencial "TEST-" é recusada em produção.
# Chave PÚBLICA do Mercado Pago (página segura de cartão /pagar/cartao; não é segredo)
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# [PREENCHER] Assinatura secreta do webhook (painel do MP > Suas integrações > Webhooks > "Revelar" a assinatura).
MP_WEBHOOK_SECRET=
# [PREENCHER] Aplicação do MP (painel > Suas integrações > a aplicação da Webag > Credenciais de produção): Client ID e Client Secret do OAuth do split.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Mesma URL cadastrada em "URLs de redirecionamento" do app do MP (HTTPS). Deixe VAZIO para usar a padrão do compose:
# https://<LOJISTA_HOST>/lojista/onboarding/4 (a etapa 4 do cadastro da loja recebe `code` e `state` e conclui a conexão).
MP_OAUTH_REDIRECT_URI=
MP_PAYER_DOCUMENT_REQUIRED=false
# PKCE (S256) no OAuth do lojista (SEC-140). Deixe true; false só se o painel do Mercado Pago recusar.
MP_OAUTH_PKCE=true

# ============================ E-mail transacional (SMTP) ============================
# O app usa STARTTLS: use a porta 587 (a 465, TLS implícito, não funciona com a versão atual).
# [PREENCHER] Dados do provedor (Brevo, Resend, Amazon SES, Mailgun...). Ver guia.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remetente: precisa ser de um domínio verificado no provedor (SPF/DKIM).
SMTP_FROM="Webag <nao-responda@exemplo.com.br>"

# ============================ Push (Expo) ============================
# `log` (padrão) NÃO envia push: só registra. `expo` envia pelo Expo Push Service; exige as credenciais FCM v1 e APNs no EAS
# (conta do fundador). EXPO_ACCESS_TOKEN é opcional ("enhanced push security" no painel do Expo).
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=

# ============================ Armazenamento de arquivos (S3) ============================
# Padrão do compose de produção: RustFS no próprio servidor (perfil storage-local), exposto em https://FILES_HOST.
# Com R2/S3: ajuste as 7 linhas (endpoint, região, chaves, buckets, URL pública) e apague COMPOSE_PROFILES acima.
S3_ENDPOINT=https://arquivos.exemplo.com.br
S3_REGION=us-east-1
S3_ACCESS_KEY=GERAR_HEX
S3_SECRET_KEY=GERAR_SEGREDO
S3_BUCKET_PUBLIC=webag-public
S3_BUCKET_PRIVATE=webag-private
# Base das URLs das fotos públicas: https://FILES_HOST/<bucket público> (R2: o domínio público/custom do bucket).
S3_PUBLIC_URL=https://arquivos.exemplo.com.br/webag-public
S3_FORCE_PATH_STYLE=true

# ============================ Geolocalização ============================
# http = ViaCEP (existência do CEP) + geocodificador opcional (único valor aceito em produção; `fake` só em staging).
GEOCODING_PROVIDER=http
# SEC-169: URL do geocodificador compatível com a busca do Nominatim (https). VAZIO = desligado, que é o padrão e funciona: a API valida só
# CEP, município e UF, os endereços ficam com pinVerified=false e o lojista ajusta o pino no mapa. O Nominatim público
# (nominatim.openstreetmap.org) é PROIBIDO aqui (política de uso do OSM; o boot recusa). Para ligar, contrate um provedor ou hospede um
# Nominatim próprio (custo no guia de deploy §Geocodificação; decisão do fundador).
GEOCODER_URL=
# Chave do provedor, enviada como `key=` na consulta. Vazio = sem chave.
GEOCODER_API_KEY=

# ============================ Observabilidade ============================
# [opcional] DSN do Sentry da API. Vazio = desligado. PII (e-mail, telefone, CPF, tokens, corpo de requisição) é removida antes do envio.
SENTRY_DSN=
# 0 a 1: fração de requisições com tracing de desempenho. 0 = só erros.
SENTRY_TRACES_SAMPLE_RATE=0

# ============================ Primeiro administrador (seed de produção) ============================
# Usado UMA vez por `sh infra/scripts/prod.sh run --rm seed`. Depois APAGUE estas duas linhas do .env.
# O admin precisa configurar o 2º fator (TOTP) no primeiro login e trocar a senha.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ============================ Backup (ver docs/deploy/guia-deploy.md, "Backup") ============================
# Frase que cifra os backups do banco (os dumps têm dados pessoais: LGPD). Guarde FORA do servidor: sem ela o backup não abre.
BACKUP_PASSPHRASE=GERAR_SEGREDO
# Horário (UTC) do backup diário: minuto hora * * *  (03:15 UTC = 00:15 em Brasília).
BACKUP_CRON="15 3 * * *"
# Quantos dias de backup ficam no servidor e na nuvem.
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE_KEEP_DAYS=30
# Cópia FORA do servidor (obrigatória na prática: backup só no mesmo disco morre junto). Bucket S3/R2 SEPARADO do de arquivos,
# com chave própria que só escreve nele. Vazio = só local (o log avisa).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# [opcional] URL de monitoramento (healthchecks.io): o backup chama no fim com sucesso; se parar de chamar, você recebe alerta.
BACKUP_HEARTBEAT_URL=

# --- Identificação da empresa e prazos da página /excluir-conta (web) ---
# [fundador] razão social e CNPJ que aparecem no rodapé do site. Os valores abaixo são EXEMPLOS (CNPJ zerado, inválido de propósito);
# troque pelos reais depois da abertura da empresa. Vazios = o rodapé mostra só "Webag". [REVISAR JURÍDICO] J11/J12
COMPANY_LEGAL_NAME=Webag Tecnologia Ltda (exemplo)
COMPANY_CNPJ=00.000.000/0001-00

# --- Textos legais do site (/privacidade, /termos, /termos/lojista, /termos/trocas; DEC-080/081) ---
# SEC-187: a versão publicada é IMUTÁVEL. Os valores abaixo são lidos SÓ pelo seed (`db:seed`, serviço `seed` em produção) e ESCRITOS no
# texto ao gravar a versão (com trilha na auditoria). Mudar um valor aqui NÃO altera nenhuma versão já publicada: o novo valor entra
# publicando uma versão nova pelo painel (o admin recusa com 422 qualquer {{...}} fora de SITE_URL, VERSAO e VIGENCIA). Vazio = o texto
# grava "a definir" (visível, nunca um dado inventado) e LEGAL_REVIEWED deve continuar false.
# [fundador] preencha com os dados REAIS (sede, encarregado, comarca, prestadores). Em produção ficam vazios no exemplo de propósito: vazio mostra "a definir" no
# texto, nunca um dado inventado. [REVISAR JURÍDICO] J12, J18, J19, J20
# COMPANY_NAME vazio = usa COMPANY_LEGAL_NAME (nome antigo da mesma variável, também usado no rodapé).
COMPANY_NAME=
COMPANY_ADDRESS=
DPO_NAME=
DPO_EMAIL=
SUPPORT_EMAIL=
# SUPPORT_WHATSAPP (só dígitos com DDI) vazio = usa NEXT_PUBLIC_SUPPORT_WHATSAPP; sem nenhum dos dois grava "a definir"
# SUPPORT_WHATSAPP=
FORO_COMARCA=
HOSTING_PROVIDER=
EMAIL_PROVIDER=
MP_LEGAL_NAME=
# Antecedência do aviso de mudança dos Termos do Lojista (dias). O PO propõe 15 [HIPÓTESE]; defina depois do parecer do advogado (J20)
AVISO_MUDANCA_DIAS=
# O domínio do site ({{SITE_URL}}) vem de PUBLIC_URL / PUBLIC_HOST; a vigência ({{VIGENCIA}}) é a data da versão publicada no admin.
# Aprovação do jurídico (J1 a J16): enquanto não for "true", as páginas mostram "Versão para revisão. Vigência a definir." (DEC-078).
# Só o CEO muda isto, depois do parecer registrado em docs/decisoes.md.
LEGAL_REVIEWED=false

# SEC-178: prazos citados na página pública de exclusão. Devem acompanhar os parâmetros do admin (exclusao_arrependimento_horas,
# retencao_fiscal_anos, retencao_log_acesso_meses) e a resposta do encarregado (15 dias). Vazio = padrão. [REVISAR JURÍDICO] J1-J14
# PUBLIC_DELETION_REGRET_HOURS=72
# PUBLIC_DELETION_FISCAL_YEARS=5
# PUBLIC_DELETION_ACCESS_LOG_MONTHS=6
# PUBLIC_DELETION_ANSWER_DAYS=15
# SEC-172: em produção o web recusa subir com PUBLIC_URL/REALTIME_URL/NEXT_PUBLIC_*URL em http ou localhost e sem PUBLIC_HOST, ADMIN_HOST, LOJISTA_HOST.

