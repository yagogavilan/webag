# Webag — modelo de variáveis de ambiente.
# Uso: cp infra/env.example .env   (Windows PowerShell: Copy-Item infra/env.example .env)
# Por que não está em `.env.example` na raiz: a permissão do time bloqueia agentes em `.env.*`
# (docs/arquitetura/divida-tecnica.md DT-008).
# Valores abaixo são SOMENTE para desenvolvimento local. Nunca commitar .env.
# Itens marcados [fundador] dependem de conta/chave do fundador; sem eles o sistema roda em modo simulado.

# --- Geral ---
NODE_ENV=development
TZ=UTC

# --- API ---
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
# Quantos proxies confiáveis existem na frente da API (nginx = 1; local = 0). Usado para o IP real (rate limit).
# Obrigatório em produção (o boot falha sem ele): sem proxy o IP do cliente é perdido e o rate limit vira global.
# Também aceita lista de IP/CIDR dos proxies (preferível: só eles podem declarar o IP via X-Forwarded-For), ex.: 127.0.0.1,10.0.0.0/8.
# Nunca use 0.0.0.0/0 (o boot recusa). A porta da API não pode ficar exposta fora da rede interna (SEC-114).
TRUST_PROXY=0
# Segredo (>= 32 caracteres) que o BFF do painel web envia em X-Webag-Bff-Secret; com ele, o IP em X-Forwarded-For
# (já resolvido pelo BFF) vale como IP do cliente. Sem ele, o BFF é tratado como qualquer cliente (SEC-114).
# Obrigatório em produção (SEC-129): o boot falha sem ele.
# BFF_SHARED_SECRET=
# Endereço do painel admin (links de convite por e-mail)
ADMIN_WEB_URL=http://localhost:3001
# Base das páginas públicas da web (ex.: /pagar/cartao, B.2). Chave PÚBLICA do Mercado Pago (MP.js/Bricks): não é segredo; vazia no provedor fake.
WEB_PUBLIC_URL=http://localhost:3001
# Endereço do painel do LOJISTA (links do convite de funcionário e do e-mail de pedido novo). Em produção é https://<LOJISTA_HOST>, outro host que o do admin (A-01).
LOJISTA_WEB_URL=http://localhost:3001
# MP_PUBLIC_KEY=
# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3001,http://localhost:3101,http://localhost:8081
LOG_LEVEL=info
# /docs (contrato OpenAPI): ligado por padrão fora de produção
# API_DOCS_ENABLED=true
# OPENAPI_SPEC_PATH=  (padrão: procura docs/arquitetura/api/openapi.yaml a partir do diretório atual)

# --- PostgreSQL + PostGIS (docker compose) ---
POSTGRES_USER=webag
POSTGRES_PASSWORD=webag_dev_only
POSTGRES_DB=webag
POSTGRES_PORT=5432
DATABASE_URL=postgresql://webag:webag_dev_only@localhost:5432/webag
# Apple Silicon (arm64): a imagem oficial postgis/postgis é só amd64; use a multi-arquitetura abaixo
# POSTGIS_IMAGE=imresamu/postgis:18-3.6-alpine

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Armazenamento S3 (RustFS no dev; ver ADR-005) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=webag-dev
S3_SECRET_KEY=webag-dev-secret-only
S3_BUCKET_PUBLIC=webag-public
S3_BUCKET_PRIVATE=webag-private
S3_PUBLIC_URL=http://localhost:9000/webag-public
S3_FORCE_PATH_STYLE=true

# --- E-mail (Mailpit no dev: UI em http://localhost:8025, recebe tudo e não envia nada para fora) ---
SMTP_HOST=localhost
SMTP_PORT=1025
# Só com provedor real (produção usa a porta 587 com STARTTLS); o Mailpit aceita qualquer login
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM="Webag <nao-responda@webag.local>"

# --- Push (Expo): `log` só registra; `expo` envia de verdade (credenciais FCM/APNs no EAS) ---
PUSH_PROVIDER=log
# [fundador] opcional: "enhanced push security" do Expo
# EXPO_ACCESS_TOKEN=

# --- Autenticação (ADR-003) ---
# Produção: gere com  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-insecure-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
# Uma chave por finalidade (>= 32 caracteres, todas distintas entre si e do JWT_ACCESS_SECRET; o boot de produção recusa repetição).
# AUTH_HMAC_KEY: derivação do refresh token.
# Produção: gere como o JWT_ACCESS_SECRET; o boot falha em produção se for este valor de desenvolvimento.
AUTH_HMAC_KEY=dev-only-insecure-hmac-key-0123456789abcdef-change-me
# HMAC dos códigos de 6 dígitos por e-mail (SEC-002) e dos códigos de recuperação do TOTP (SEC-092).
CODE_HMAC_KEY=dev-only-insecure-code-hmac-key-0123456789abcdef-change-me
RECOVERY_HMAC_KEY=dev-only-insecure-recovery-hmac-key-0123456789abcdef-change-me
# Cifra do segredo TOTP dos admins (SEC-090).
# Produção: gere como o JWT_ACCESS_SECRET e guarde fora do banco e dos backups dele; o boot falha com o valor de dev.
MFA_ENC_KEY=dev-only-insecure-mfa-key-0123456789abcdef-change-me
REFRESH_TTL_DAYS=30
REFRESH_ABSOLUTE_TTL_DAYS=90

# --- Pagamentos (ADR-002) ---
# fake = provedor simulado (padrão). mercadopago = real (exige as chaves abaixo).
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_WEBHOOK_SECRET=dev-only-fake-webhook-secret
# [fundador] Painel de desenvolvedor do Mercado Pago > Suas integrações > aplicação da Webag
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Página que recebe o retorno do OAuth e repassa `code` e `state` à API (POST /v1/stores/{id}/payment-account/callback): a etapa 4 do cadastro da loja
# no painel do lojista (/lojista/onboarding/4). Cadastre a MESMA URL no app do MP (o MP só aceita HTTPS em produção). Com o provedor `fake` não é usada.
MP_OAUTH_REDIRECT_URI=http://localhost:3001/lojista/onboarding/4
# true se o PIX do MP exigir o CPF do pagador [confirmar no sandbox]
MP_PAYER_DOCUMENT_REQUIRED=false
# PKCE (S256) no OAuth do lojista (SEC-140). Deixe true; false só se o painel do Mercado Pago recusar.
MP_OAUTH_PKCE=true

# --- Observabilidade ---
# [fundador] opcional; vazio = Sentry desligado (só a API lê esta variável hoje; web e app, ver divida-tecnica.md DT-039)
SENTRY_DSN=
# 0 a 1: fração das requisições com tracing de desempenho. 0 = só erros
SENTRY_TRACES_SAMPLE_RATE=0

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3000
# Endereço INTERNO da API usado pelo servidor do painel (BFF). Padrão http://localhost:3000; mude se API_PORT mudou
# API_URL=http://localhost:3000
# Site público (páginas /pagar/cartao, /privacidade, /excluir-conta...). Em dev qualquer host serve; em produção PUBLIC_HOST é obrigatório.
# PUBLIC_URL=http://localhost:3001
# Links dos botões de download da página inicial (https). Vazios = a página mostra "em breve"
# PLAY_STORE_URL=
# APP_STORE_URL=
# WhatsApp de suporte exibido nos painéis (só dígitos com DDI). Entra no navegador; muda só com novo build do web
# NEXT_PUBLIC_SUPPORT_WHATSAPP=

# --- Identificação da empresa e prazos da página /excluir-conta (web) ---
# [fundador] razão social e CNPJ que aparecem no rodapé do site. Os valores abaixo são EXEMPLOS (CNPJ zerado, inválido de propósito);
# troque pelos reais depois da abertura da empresa. Vazios = o rodapé mostra só "Webag". [REVISAR JURÍDICO] J11/J12
COMPANY_LEGAL_NAME=Webag Tecnologia Ltda (exemplo)
COMPANY_CNPJ=00.000.000/0001-00

# --- Textos legais do site (/privacidade, /termos, /termos/lojista, /termos/trocas; DEC-080/081) ---
# O texto vem da API (versão imutável) com variáveis {{NOME}} que o site preenche com os valores abaixo. Vazio = o texto mostra "a definir".
# Os valores desta lista são EXEMPLOS para desenvolvimento, NÃO dados reais: o fundador troca pelos reais (razão social, CNPJ, sede,
# encarregado, comarca). [REVISAR JURÍDICO] J12, J18, J19, J20
# COMPANY_NAME vazio = usa COMPANY_LEGAL_NAME (nome antigo da mesma variável, também usado no rodapé).
COMPANY_NAME=
COMPANY_ADDRESS=Rua Exemplo, 100, Francisco Morato, SP (exemplo)
DPO_NAME=Encarregado Exemplo (exemplo)
DPO_EMAIL=privacidade@webag.exemplo
SUPPORT_EMAIL=ajuda@webag.exemplo
# SUPPORT_WHATSAPP (só dígitos com DDI) vazio = usa NEXT_PUBLIC_SUPPORT_WHATSAPP, depois o contato publicado no admin
# SUPPORT_WHATSAPP=
FORO_COMARCA=Comarca de Exemplo (exemplo)
HOSTING_PROVIDER=Provedor de hospedagem (exemplo)
EMAIL_PROVIDER=Provedor de e-mail (exemplo)
MP_LEGAL_NAME=Razão social do Mercado Pago (exemplo; confirmar com o jurídico)
# Antecedência do aviso de mudança dos Termos do Lojista (dias). Proposta do PO: 15 [HIPÓTESE]; o advogado decide (J20)
AVISO_MUDANCA_DIAS=15
# O domínio do site ({{SITE_URL}}) vem de PUBLIC_URL / PUBLIC_HOST. DPO e suporte vazios caem no contato publicado no admin.
# Aprovação do jurídico (J1 a J16): enquanto não for "true", as páginas mostram "Versão para revisão. Vigência a definir." (DEC-078).
# Só o CEO muda isto, depois do parecer registrado em docs/decisoes.md.
LEGAL_REVIEWED=false
# [opcional, só com LEGAL_REVIEWED=true] data de vigência AAAA-MM-DD; vazio = data de vigência da versão publicada no admin. Nunca fixe aqui uma data antiga.
# LEGAL_VIGENCIA=

# SEC-178: prazos citados na página pública de exclusão. Devem acompanhar os parâmetros do admin (exclusao_arrependimento_horas,
# retencao_fiscal_anos, retencao_log_acesso_meses) e a resposta do encarregado (15 dias). Vazio = padrão. [REVISAR JURÍDICO] J1-J14
# PUBLIC_DELETION_REGRET_HOURS=72
# PUBLIC_DELETION_FISCAL_YEARS=5
# PUBLIC_DELETION_ACCESS_LOG_MONTHS=6
# PUBLIC_DELETION_ANSWER_DAYS=15
# SEC-172: em produção o web recusa subir com PUBLIC_URL/REALTIME_URL/NEXT_PUBLIC_*URL em http ou localhost e sem PUBLIC_HOST, ADMIN_HOST, LOJISTA_HOST.

# --- Mobile (Expo) — tudo que começa com EXPO_PUBLIC_ vai embutido no app (é público) ---
# No celular físico (Expo Go) troque localhost pelo IP da sua máquina na rede (ex.: http://192.168.0.10:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000
# Site público (WEB_PUBLIC_URL da API): o cartão abre <url>/pagar/cartao no navegador do sistema; o app só abre esta origem. No celular físico, também o IP da máquina
EXPO_PUBLIC_WEB_URL=http://localhost:3001
# development | staging | production. Em production o app exige o cartão real (Mercado Pago); nos outros o provedor `fake` vale
# EXPO_PUBLIC_APP_ENV=development
# Chave PÚBLICA do Mercado Pago embutida no app (mesma de MP_PUBLIC_KEY; não é segredo)
# EXPO_PUBLIC_MP_PUBLIC_KEY=
# WhatsApp de suporte no app (só dígitos com DDI)
# EXPO_PUBLIC_SUPPORT_WHATSAPP=

# --- Seed (só desenvolvimento) ---
# Admin inicial criado por `pnpm run setup` (precisa configurar o TOTP no primeiro login).
SEED_ADMIN_EMAIL=admin@webag.local
SEED_ADMIN_PASSWORD=Webag-Admin-Dev-2026
# Seed da Onda 2 (lojas fictícias): em desenvolvimento roda sozinho com senha padrão pública; em produção precisa dos dois.
# SEED_ONDA2=true
# SEED_MERCHANT_PASSWORD=

# --- Uploads e lojas (Onda 2) ---
# s3 (RustFS no compose / R2 em produção) ou memory (SÓ testes; o boot de produção recusa).
STORAGE_DRIVER=s3
# fake = CEP determinístico sem rede (dev/teste). http = ViaCEP (existência do CEP, rua, bairro, cidade) + geocodificador opcional abaixo.
GEOCODING_PROVIDER=fake
# SEC-169: geocodificador (CEP -> coordenada), API compatível com a busca do Nominatim. VAZIO = desligado (padrão): a API valida só CEP,
# município e UF e grava o endereço com pinVerified=false. NUNCA aponte para nominatim.openstreetmap.org (a política de uso proíbe o volume de
# endereços de clientes; o boot de produção recusa). Use um Nominatim próprio ou um provedor com contrato (ex.: LocationIQ) [exige o fundador].
GEOCODER_URL=
# Chave do provedor, enviada como `key=` (estilo LocationIQ). Vazio = sem chave.
GEOCODER_API_KEY=
# Cifra dos tokens OAuth do provedor de pagamentos (32 bytes em base64). Produção: gere com
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# e guarde fora do banco e dos backups dele; o boot de produção recusa o valor de desenvolvimento.
PAYMENT_TOKEN_ENC_KEY=CQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQkJCQk=
# --- Painel web (apps/web): BFF de sessão e separação de hosts (SEC-114, SEC-116) ---
# Hosts distintos para admin e lojista (em produção o web recusa tudo se faltarem; em dev qualquer host serve).
# ADMIN_HOST=admin.exemplo.com.br
# LOJISTA_HOST=lojista.exemplo.com.br
# IP do cliente: use UM dos dois. Nunca confie no X-Forwarded-For enviado pelo navegador.
# WEB_CLIENT_IP_HEADER=x-real-ip        # cabeçalho definido pelo proxy reverso (nginx: proxy_set_header X-Real-IP $remote_addr)
# WEB_TRUSTED_PROXY_HOPS=1              # ou: N-ésimo valor da direita do X-Forwarded-For
# Deve ser igual ao BFF_SHARED_SECRET da API (>= 32 caracteres).
# Obrigatório em produção (SEC-129): o boot falha sem ele.
# BFF_SHARED_SECRET=
